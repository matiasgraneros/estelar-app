e{height:1px;width:17px;background:#5bd9d0}h1{font-size:32px;letter-spacing:.08em;font-weight:560;margin:10px 0 5px;line-height:1}h1 span{color:#65727f;font-weight:350}.mission-subtitle{margin:0;color:#75818e;font-size:11px}.mission-state{height:29px;border:1px solid #24504f;border-radius:3px;background:rgba(44,131,123,.09);color:#65d8cd;font-size:8px;font-weight:700;letter-spacing:.11em;display:flex;align-items:center;gap:8px;padding:0 10px;margin-bottom:2px}.state-divider{height:11px;width:1px;background:#31514f;margin:0 2px}.state-label{color:#94a5aa;font-size:8px}.hero-grid{display:grid;grid-template-columns:1.16fr .84fr;gap:14px}.planet-card,.trajectory-card,.metric-card,.systems-card,.log-card{background:#0c1118;border:1px solid #1c2631;border-radius:5px;overflow:hidden}.planet-card,.trajectory-card{height:327px}.card-top{display:flex;justify-content:space-between;align-items:start;padding:17px 18px 0}.card-top h2,.section-heading h2{font-size:14px;margin:6px 0 0;font-weight:550;letter-spacing:.01em}.more-button{border:0;background:none;color:#7c8997;letter-spacing:2px;font-size:16px;padding:0}.card-index{font:9px ui-monospace,monospace;color:#65717f;padding-top:3px}.planet-stage{height:205px;position:relative;overflow:hidden;background:radial-gradient(ellipse at 50% 60%,rgba(42,79,90,.16),transparent 60%)}.planet{position:absolute;width:160px;height:160px;border-radius:50%;left:50%;top:48%;transform:translate(-50%,-50%);overflow:hidden;background:radial-gradient(circle at 33% 29%,#789695 0%,#446d70 28%,#294650 58%,#131f2a 78%);box-shadow:inset -22px -10px 35px rgba(0,0,0,.78),inset 6px 4px 18px rgba(144,198,184,.18),0 0 32px rgba(61,147,146,.16)}.planet:after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,transparent 35%,rgba(5,11,18,.1) 49%,rgba(3,8,14,.79) 79%)}.planet-light{position:absolute;width:80px;height:90px;background:rgba(177,220,198,.15);filter:blur(19px);left:15px;top:8px;border-radius:50%}.planet-land{position:absolute;background:#729081;opacity:.45;filter:blur(2px);border-radius:50%}.land-one{width:56px;height:23px;top:37px;left:28px;transform:rotate(-27deg)}.land-two{width:34px;height:16px;top:75px;left:85px;transform:rotate(35deg);background:#8da58b}.land-three{width:23px;height:12px;top:108px;left:42px;transform:rotate(12deg)}.orbit{position:absolute;border:1px solid rgba(100,185,183,.2);border-radius:50%;left:50%;top:50%;transform:translate(-50%,-47%) rotate(-17deg)}.orbit-one{width:265px;height:93px}.orbit-two{width:320px;height:121px;transform:translate(-50%,-47%) rotate(19deg);border-color:rgba(100,185,183,.1)}.planet-moon{position:absolute;width:5px;height:5px;left:calc(50% + 116px);top:39px;background:#a7d9cf;border-radius:50%;box-shadow:0 0 10px #9aede0}.planet-caption{position:absolute;bottom:9px;left:18px;color:#c2d0d6;font:8px ui-monospace,monospace;letter-spacing:.1em}.caption-dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:#60dacf;margin-right:6px;vertical-align:1px}.caption-coords{color:#657583;margin-left:7px}.planet-footer{height:67px;border-top:1px solid #1b252e;display:grid;grid-template-columns:1fr 1.1fr 1.15fr;align-items:center;padding:0 18px}.planet-footer>div+div{border-left:1px solid #202b35;padding-left:17px}.detail-label{display:block;color:#667481;font-size:8px;font-weight:650;letter-spacing:.1em;margin-bottom:7px}.planet-footer strong,.trajectory-stats strong{font:500 13px ui-monospace,monospace;color:#d8e0e7}.planet-footer small,.trajectory-stats small{font-size:9px;color:#85929e}.star-class{font-size:12px!important}.star-class i{display:inline-block;width:6px;height:6px;background:#ffb66c;border-radius:50%;box-shadow:0 0 9px #ffac5f;margin-right:5px}.star-class small{display:block;font:7px ui-sans-serif,sans-serif;letter-spacing:.1em;margin-top:3px}.trajectory-visual{height:202px;margin:4px 15px 0;position:relative;overflow:hidden;background-image:linear-gradient(rgba(57,77,91,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(57,77,91,.08) 1px,transparent 1px);background-size:25px 25px}.trajectory-orbit{position:absolute;width:285px;height:120px;border:1px solid rgba(97,141,157,.35);border-radius:50%;top:43px;left:50%;transform:translateX(-50%) rotate(-20deg)}.star-core{position:absolute;width:29px;height:29px;border-radius:50%;left:23%;top:98px;background:radial-gradient(circle at 40% 40%,#fff2c4,#ecac61 34%,#b9673f 65%,transparent 73%);box-shadow:0 0 21px rgba(241,161,85,.36)}.star-core span{position:absolute;inset:-11px;border:1px solid rgba(234,168,108,.18);border-radius:50%}.path-line{position:absolute;height:1px;width:63%;left:27%;top:111px;background:linear-gradient(90deg,rgba(246,172,96,.65),#5ed8d0 70%,rgba(94,216,208,.08));transform:rotate(-19deg);transform-origin:left}.ship-marker{position:absolute;left:67%;top:79px;color:#71e7dc;font-size:12px;text-shadow:0 0 12px #53d5ca;transform:rotate(40deg)}.target-marker{position:absolute;right:12%;top:56px;width:7px;height:7px;border:1px solid #7ae6da;border-radius:50%;box-shadow:0 0 9px #61ddd2}.route-label{position:absolute;color:#8495a0;font:7px ui-monospace,monospace;letter-spacing:.08em}.label-origin{left:20%;top:139px}.label-target{right:7%;top:44px;color:#85d9d1}.label-ship{left:64%;top:99px;color:#61d9cf}.grid-cross{position:absolute;width:5px;height:5px;border:1px solid #637787;opacity:.65}.cross-a{right:24%;top:150px}.cross-b{left:45%;top:36px}.trajectory-stats{height:56px;border-top:1px solid #1b252f;display:grid;grid-template-columns:1fr 1fr 1fr;padding:9px 17px 0}.trajectory-stats>div+div{border-left:1px solid #202b35;padding-left:12px}.trajectory-stats .detail-label{font-size:7px;margin-bottom:5px}.trajectory-stats strong{font-size:12px}.progress-wrap>span{font-size:7px;color:#697885;letter-spacing:.08em}.progress-track{height:3px;margin-top:9px;background:#202b35;border-radius:4px}.progress-track i{display:block;width:68%;height:100%;background:#56d6cb;box-shadow:0 0 6px rgba(86,214,203,.4)}.section-block{margin-top:28px}.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:12px}.section-heading h2{font-size:16px;margin-top:5px}.text-link{color:#69cfc7;font-size:8px;font-weight:650;letter-spacing:.1em}.text-link span{font-size:12px;margin-left:6px}.telemetry-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.metric-card{height:125px;padding:13px 15px}.metric-head{display:flex;justify-content:space-between;color:#85919e;font-size:10px}.metric-icon{color:#64dacf;font-size:15px}.metric-value{font:500 26px ui-monospace,monospace;letter-spacing:-.06em;margin-top:8px;color:#e5edf2}.metric-value small{font:10px ui-sans-serif,sans-serif;letter-spacing:.02em;color:#788794;margin-left:6px}.metric-bottom{display:flex;justify-content:space-between;align-items:center;margin-top:6px}.metric-change{font:8px ui-monospace,monospace;color:#60d5c9}.metric-change.neutral{color:#7a8b96;font-size:7px;letter-spacing:.05em}.sparkline{height:20px;display:flex;align-items:end;gap:2px;width:86px}.sparkline i{display:block;width:3px;height:35%;background:#286b68;opacity:.78;border-radius:1px}.sparkline i:nth-child(2n){height:56%}.sparkline i:nth-child(3n){height:78%}.sparkline i:nth-child(4n){height:42%}.sparkline i:nth-child(5n){height:95%;background:#57d3c8}.spark-2 i{background:#344b52}.spark-2 i:nth-child(5n){background:#5b8785}.spark-3 i{background:#344b52}.spark-3 i:nth-child(5n){background:#688b8d}.lower-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:14px;margin-top:25px}.systems-card,.log-card{padding:15px 17px 13px;min-height:176px}.section-heading.compact{align-items:center;margin-bottom:13px}.section-heading.compact h2{font-size:13px}.section-heading.compact .eyebrow{font-size:8px}.systems-list{display:grid}.system-row{height:34px;display:grid;grid-template-columns:22px 1.1fr 84px 1fr 34px;align-items:center;gap:8px;border-top:1px solid #19232d}.system-icon{font-size:14px;color:#718b93}.system-row strong{font-size:9px;font-weight:550;