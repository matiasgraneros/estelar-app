---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const requestTime = new Date();
const formattedTime = new Intl.DateTimeFormat('es', {
	timeZone: 'UTC',
	dateStyle: 'full',
	timeStyle: 'medium',
}).format(requestTime);

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate');
---

<Layout title="DEMO SSR — ORBITAL">
	<main class="ssr-page">
		<a class="back-link" href="/">← VOLVER AL CENTRO DE CONTROL</a>
		<section class="clock-panel">
			<div class="eyebrow"><span></span> RENDERIZADO EN SERVIDOR · CLOUDFLARE</div>
			<h1>Señal de tiempo</h1>
			<p class="intro">Esta marca de tiempo se genera cuando el servidor recibe cada solicitud.</p>
			<div class="time-readout" aria-live="polite">
				<span class="time-label">HORA DEL SERVIDOR · UTC</span>
				<time datetime={requestTime.toISOString()}>{formattedTime}</time>
				<span class="timestamp">{requestTime.toISOString()}</span>
			</div>
			<div class="request-meta"><span class="status-dot"></span> HTML GENERADO PARA ESTA PETICIÓN <span class="meta-method">{Astro.request.method}</span></div>
			<a class="refresh-button" href="/server-time"><span>↻</span> Solicitar hora nueva</a>
			<p class="hint">Recarga la página o pulsa el botón para enviar otra solicitud y comparar la hora.</p>
		</section>
	</main>
</Layout>

<style>
	:global(body){min-height:100vh;background:radial-gradient(ellipse at 50% 34%,rgba(31,77,83,.18),transparent 47%),#080b10;color:#e8edf5;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;margin:0}
	.ssr-page{min-height:100vh;max-width:980px;margin:auto;padding:35px 28px}.back-link{color:#7a8996;font:8px ui-monospace,monospace;letter-spacing:.1em}.back-link:hover{color:#73ddd3}.clock-panel{max-width:650px;margin:14vh auto 0;padding:34px 38px;background:rgba(12,17,24,.94);border:1px solid #24313c;border-radius:6px;box-shadow:0 20px 90px rgba(0,0,0,.24)}.eyebrow{font-size:9px;font-weight:700;letter-spacing:.15em;color:#65d3c9}.eyebrow span,.status-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#5cdbd0;box-shadow:0 0 9px rgba(92,219,208,.65);vertical-align:1px;margin-right:6px}h1{font-size:30px;letter-spacing:.015em;font-weight:550;margin:13px 0 6px}.intro{font-size:12px;color:#82909d;margin:0}.time-readout{margin-top:31px;padding:21px 20px;background:#0a1016;border:1px solid #1e2a34;border-left:2px solid #58d5ca}.time-label{display:block;color:#6e7d8a;font-size:8px;font-weight:700;letter-spacing:.13em;margin-bottom:10px}.time-readout time{display:block;color:#e1ecef;font-size:19px;font-weight:500;letter-spacing:.01em}.timestamp{display:block;color:#66d6cc;font:11px ui-monospace,monospace;margin-top:9px}.request-meta{display:flex;align-items:center;color:#72818d;font:8px ui-monospace,monospace;letter-spacing:.06em;margin-top:20px}.request-meta .status-dot{width:5px;height:5px;margin-right:8px}.meta-method{margin-left:auto;color:#81919c;border:1px solid #29343e;border-radius:2px;padding:4px 6px}.refresh-button{display:inline-flex;align-items:center;gap:9px;margin-top:25px;background:#15302f;border:1px solid #326b66;border-radius:3px;padding:11px 14px;color:#82e1d7;font-size:10px;font-weight:650}.refresh-button:hover{background:#1a4140;border-color:#5acfc5}.refresh-button span{font-size:15px}.hint{font-size:9px;color:#6b7986;margin:12px 0 0}@media(max-width:600px){.ssr-page{padding:24px 16px}.clock-panel{margin-top:12vh;padding:25px 19px}.time-readout time{font-size:17px}.request-meta{font-size:7px;letter-spacing:.02em}}
</style>
